# 의존성
node_modules/

# 빌드 산출물
client/dist/
server/dist/
release/
*.bak
.*.bak

# 모바일(APK) 생성물 — mobile/의 설정 3파일만 커밋, 나머지는 npx cap add android로 재생성
mobile/www/
mobile/android/

# 사용자 데이터 (비밀번호 해시 포함 — 절대 커밋 금지)
server/data/
data/db.json

# 터널/DNS 설정 (토큰 포함 가능) 및 다운로드 바이너리
**/ngrok-config.txt
**/ddns-config.txt
**/cloudflared.exe
**/ngrok.exe
**/ngrok.zip

# 대용량/저작권 원본 (재수집 가능) — Riot 규칙 PDF는 재배포하지 않음
tools/data/*.pdf
client/web/assets/*.pdf
tools/data/rules*.txt
tools/data/ogn_*.json

# 카드 이미지 로컬 캐시 (약 11MB · Riot CDN에서 재수집 가능)
# `node tools/fetch-card-images.js` 로 받는다. 빌드(predist)가 자동으로 확보하며,
# 없으면 앱이 CDN에서 직접 불러오므로 동작에는 문제가 없다.
client/web/assets/cards/
client/web/js/imgmap.js

# 로컬 도구/OS
.claude/
.vscode/
.DS_Store
Thumbs.db
*.log

# 접근 코드(입장 통제) — 절대 커밋 금지
**/access-code.txt
